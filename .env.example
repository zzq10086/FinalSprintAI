# ============================================================
# FinalSprint AI 模型配置
# 复制本文件为 .env，然后把 AI_API_KEY 换成你自己的密钥。
# 不要把 .env 提交到 Git，也不要把密钥发到聊天或截图里。
# ============================================================

# 通义千问（阿里云百炼）OpenAI 兼容接口
AI_PROVIDER=通义千问
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_MODEL=qwen-plus
AI_API_KEY=sk-在这里填写你的密钥

# 单次请求超时时间（秒）
AI_TIMEOUT=60

# 一次分析最多处理多少个文本段（控制费用）
AI_MAX_CHUNKS=20

# 每个文本段的目标字符数
AI_CHUNK_SIZE=6000

# ------------------------------------------------------------
# 其他 OpenAI 兼容服务示例，按需替换上面的四项：
#
# DeepSeek:
# AI_PROVIDER=DeepSeek
# AI_BASE_URL=https://api.deepseek.com
# AI_MODEL=deepseek-chat
#
# 智谱 GLM:
# AI_PROVIDER=智谱
# AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# AI_MODEL=glm-4-flash
#
# OpenAI:
# AI_PROVIDER=OpenAI
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# ------------------------------------------------------------
